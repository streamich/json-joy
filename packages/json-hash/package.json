{
  "name": "@jsonjoy.com/json-hash",
  "publishConfig": {
    "access": "public"
  },
  "version": "18.28.0",
  "description": "Structural hashing for JSON values",
  "author": {
    "name": "streamich",
    "url": "https://github.com/streamich"
  },
  "homepage": "https://github.com/streamich/json-joy/tree/master/packages/json-hash",
  "repository": {
    "type": "git",
    "url": "https://github.com/streamich/json-joy.git",
    "directory": "packages/json-hash"
  },
  "license": "Apache-2.0",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/streamich"
  },
  "keywords": [
    "json",
    "hash",
    "json-hash",
    "structural-hash",
    "djb2",
    "checksum",
    "digest"
  ],
  "peerDependencies": {
    "tslib": "*"
  },
  "dependencies": {
    "@jsonjoy.com/json-pack": "workspace:*",
    "@jsonjoy.com/util": "workspace:*"
  },
  "devDependencies": {
    "@jsonjoy.com/json-random": "workspace:*"
  },
  "engines": {
    "node": ">=10.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "typings": "lib/index.d.ts",
  "files": [
    "LICENSE",
    "lib/"
  ],
  "scripts": {
    "clean": "npx rimraf lib typedocs coverage gh-pages yarn-error.log",
    "build": "tsc -b tsconfig.build.json",
    "typedoc": "typedoc",
    "typecheck": "tsc -b --noEmit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "tsx"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      ".*/node_modules/.*"
    ],
    "testRegex": ".*/(__tests__|__jest__|demo)/.*(?<!\\.vi)\\.(test|spec)\\.tsx?$",
    "rootDir": ".",
    "testPathIgnorePatterns": [
      "node_modules",
      "\\.vi\\.(test|spec)\\.tsx?$"
    ]
  }
}

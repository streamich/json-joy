{
  "name": "@jsonjoy.com/site",
  "version": "18.23.0",
  "description": "jsonjoy.com documentation site",
  "author": {
    "name": "streamich",
    "url": "https://github.com/streamich"
  },
  "homepage": "https://github.com/streamich/json-joy/tree/master/packages/site",
  "repository": {
    "type": "git",
    "url": "https://github.com/streamich/json-joy.git",
    "directory": "packages/site"
  },
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production",
    "prerender": "yarn build && ts-node --project tsconfig.prerender.json scripts/prerender.tsx",
    "deploy": "yarn prerender && wrangler pages deploy --branch=master dist",
    "deploy:preview": "yarn build && yarn prerender && wrangler pages deploy --branch=preview dist",
    "typecheck": "npx tsc --noEmit -p tsconfig.app.json",
    "clean": "npx rimraf dist"
  },
  "dependencies": {
    "@jsonjoy.com/ui": "workspace:*",
    "nano-theme": "workspace:*",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-lite": "^1.6.0",
    "rx-use": "^1.9.0",
    "rxjs": "7"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "ts-node": "*",
    "webpack": "^5.99.5",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "wrangler": "^4.81.1"
  }
}

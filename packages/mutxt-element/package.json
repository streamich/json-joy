  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.16",
    "ts-loader": "^9.5.4",
    "tslib": "^2.8.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }

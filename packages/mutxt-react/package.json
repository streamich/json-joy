{
  "name": "mutxt-react",
  "publishConfig": {
    "access": "public"
  },
  "version": "18.21.0",
  "description": "Batteries-included React rich-text editor",
  "author": {
    "name": "streamich",
    "url": "https://github.com/streamich"
  },
  "homepage": "https://mutxt.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/streamich/json-joy.git",
    "directory": "packages/mutxt-react"
  },
  "license": "AGPL-3.0-only",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/streamich"
  },
  "keywords": [
    "mutxt",
    "react",
    "rich-text",
    "editor",
    "collaborative",
    "real-time",
    "json",
    "crdt",
    "slate",
    "slatejs",
    "plate",
    "platejs",
    "json-joy",
    "peritext",
    "sync"
  ],
  "engines": {
    "node": ">=10.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "typings": "lib/index.d.ts",
  "files": [
    "LICENSE",
    "lib/"
  ],
  "scripts": {
    "clean": "npx rimraf lib typedocs coverage gh-pages yarn-error.log",
    "build": "tsc -b tsconfig.build.json",
    "jest": "node -r ts-node/register ./node_modules/.bin/jest",
    "test": "jest --maxWorkers 7",
    "test:ci": "yarn jest --maxWorkers 3 --no-cache",
    "coverage": "yarn test --collectCoverage",
    "typedoc": "typedoc",
    "build:pages": "npx rimraf gh-pages && mkdir -p gh-pages && cp -r typedocs/* gh-pages && cp -r coverage gh-pages/coverage",
    "deploy:pages": "gh-pages -d gh-pages",
    "publish-coverage-and-typedocs": "yarn typedoc && yarn coverage && yarn build:pages && yarn deploy:pages",
    "typecheck": "tsc -b --noEmit"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "js",
      "tsx"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      ".*/node_modules/.*"
    ],
    "testRegex": ".*/(__tests__|__jest__|demo)/.*(?<!\\.vi)\\.(test|spec)\\.tsx?$",
    "rootDir": ".",
    "testPathIgnorePatterns": [
      "node_modules",
      "\\.vi\\.(test|spec)\\.tsx?$"
    ]
  },
  "dependencies": {
    "@fontsource-variable/bitter": "^5.2.0",
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/source-serif-4": "^5.2.0",
    "@jsonjoy.com/base64": "workspace:*",
    "@jsonjoy.com/collaborative-peritext": "workspace:*",
    "@jsonjoy.com/collaborative-presence": "workspace:*",
    "@jsonjoy.com/collaborative-slate": "workspace:*",
    "@jsonjoy.com/keyboard": "workspace:*",
    "@jsonjoy.com/ui": "workspace:*",
    "@jsonjoy.com/util": "workspace:*",
    "code-colors": "^2.5.0",
    "code-colors-react": "^3.5.0",
    "emoji-picker-react": "^4.19.1",
    "iconista": "^2.25.1",
    "json-joy": "workspace:*",
    "nano-theme": "workspace:*",
    "react-embed": "^3.7.0",
    "slate-history": "^0.113.1",
    "use-t": "^1.6.4"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "slate": ">=0.100.0",
    "slate-react": ">=0.100.0",
    "tslib": "2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    },
    "slate": {
      "optional": false
    },
    "slate-react": {
      "optional": false
    }
  },
  "devDependencies": {
    "@jsonjoy.com/collaborative-ui": "workspace:*",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "slate": "^0.123.0",
    "slate-dom": "^0.123.0",
    "slate-react": "^0.123.0"
  }
}

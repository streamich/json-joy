{
  "id": "/",
  "name": "Mutxt",
  "short_name": "Mutxt",
  "description": "A multi-file rich-text workspace powered by mutxt-react and json-joy.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "icons": [
    {
      "src": "/icons/mutxt-16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/icons/mutxt-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/icons/mutxt-64.png",
      "sizes": "64x64",
      "type": "image/png"
    },
    {
      "src": "/icons/mutxt-128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/icons/mutxt-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icons/mutxt-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}